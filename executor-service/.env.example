SERVICE_NAME=executor-service
SERVICE_VERSION=dev
# Empty uses the hostname, which is the pod name in Kubernetes
EXECUTOR_ID=
SHUTDOWN_GRACE_PERIOD=30s
JOB_QUEUE_SIZE=1000
JOB_TIME_LIMIT_SECONDS=10
WORKER_COUNT=50
DATABASE_DSN=scheduler:scheduler@tcp(localhost:3307)/scheduler?parseTime=true&loc=UTC&time_zone=%27%2B00%3A00%27
# Turns the SSRF check off so jobs can call localhost. Local tests only, never in production
ALLOW_PRIVATE_DESTINATIONS=false

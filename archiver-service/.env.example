SERVICE_NAME=archiver-service
SERVICE_VERSION=dev
SHUTDOWN_GRACE_PERIOD=30s
ARCHIVE_INTERVAL=1m
ARCHIVE_BATCH_SIZE=500
SUCCEEDED_RETENTION=1h
# The DLQ retry window promised to tenants: 14 days
DEAD_RETENTION=336h
DATABASE_DSN=scheduler:scheduler@tcp(localhost:3307)/scheduler?parseTime=true&loc=UTC&time_zone=%27%2B00%3A00%27
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_KEYSPACE=scheduler
